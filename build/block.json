{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rafaelfunchal/animated-raffle-winner",
  "version": "1.1",
  "title": "Animated Raffle Winner",
  "category": "widgets",
  "icon": "randomize",
  "description": "Create interactive raffles with number animation and fireworks",
  "example": {
    "attributes": {
      "startingNumber": 1,
      "endingNumber": 100,
      "raffleDuration": 5,
      "fullscreen": false,
      "animationType": "fireworks"
    }
  },
  "attributes": {
    "raffleMode": {
      "type": "string",
      "default": "numbers"
    },
    "startingNumber": {
      "type": "number",
      "default": 1
    },
    "endingNumber": {
      "type": "number",
      "default": 100
    },
    "startingLetter": {
      "type": "string",
      "default": "A"
    },
    "endingLetter": {
      "type": "string",
      "default": "C"
    },
    "theaterStartingNumber": {
      "type": "number",
      "default": 1
    },
    "theaterEndingNumber": {
      "type": "number",
      "default": 10
    },
    "csvFileName": {
      "type": "string",
      "default": ""
    },
    "csvRawContent": {
      "type": "string",
      "default": ""
    },
    "csvSkipHeader": {
      "type": "boolean",
      "default": false
    },
    "csvSelectedColumns": {
      "type": "array",
      "default": [
        0
      ]
    },
    "csvUseSeparator": {
      "type": "boolean",
      "default": false
    },
    "csvItems": {
      "type": "array",
      "default": []
    },
    "excludePreviousWinners": {
      "type": "boolean",
      "default": false
    },
    "customTitle": {
      "type": "string",
      "default": ""
    },
    "hideSubtitle": {
      "type": "boolean",
      "default": false
    },
    "raffleDuration": {
      "type": "number",
      "default": 5
    },
    "fullscreen": {
      "type": "boolean",
      "default": false
    },
    "animationType": {
      "type": "string",
      "default": "fireworks"
    },
    "textSize": {
      "type": "string",
      "default": "medium"
    },
    "backgroundColor": {
      "type": "string"
    },
    "overlayOpacity": {
      "type": "number",
      "default": 100
    },
    "gradient": {
      "type": "string"
    },
    "buttonColor": {
      "type": "string"
    },
    "textColor": {
      "type": "string"
    },
    "buttonTextColor": {
      "type": "string"
    },
    "backgroundImageUrl": {
      "type": "string"
    },
    "backgroundImageId": {
      "type": "number"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "textdomain": "animated-raffle-winner",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}